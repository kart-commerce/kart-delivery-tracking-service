<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Application\KartDeliveryTrackingService.Application.csproj" />
    <ProjectReference Include="..\Domain\KartDeliveryTrackingService.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
    <PackageReference Include="Kart.Shared.Messaging" Version="0.1.0" />
    <!-- kart-conventions.md Observability section: KartFlowContext/FlowEnricher for this layer's
         hosted services (outbox relay, RabbitMQ consumers, sweep hosted services) - the Api layer
         already references this for AddKartObservability/controllers; this project needs it
         directly for its own BackgroundService entry points (same pattern as kart-offer-service's
         Infrastructure.csproj). -->
    <PackageReference Include="Kart.Shared.Observability" Version="0.3.0" />
    <PackageReference Include="Polly" Version="8.4.2" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Transitive pins: MongoDB.Driver.Core 2.28.0 pulls vulnerable versions of these. Pin directly to patched
         versions rather than bumping MongoDB.Driver to a major version with breaking changes.
         SharpCompress: GHSA-6c8g-7p36-r338 (directory traversal, fixed 0.48.0)
         Snappier: GHSA-pggp-6c3x-2xmx (infinite loop on malformed input, fixed 1.3.1) -->
    <PackageReference Include="SharpCompress" Version="0.48.0" />
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for BackgroundService (OutboxRelayHostedService, consumer/poller/sweep hosted services) and IHttpClientFactory (carrier polling client). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
